# URL base da API AureBid (inclui o prefixo /api/v1)
VITE_API_URL=http://localhost:3000/api/v1

# URL do servidor Socket.IO (origem, sem prefixo de API)
VITE_SOCKET_URL=http://localhost:3000

# true: usa MSW + socket simulado, com dados de demonstração
# false: consome o backend real
VITE_USE_MOCKS=true

# Opcional: latência simulada das respostas em milissegundos (padrão: 220)
VITE_MOCK_LATENCY_MS=220
